# MongoDB connection string
MONGODB_URI=

# Secret used to sign/verify auth JWTs
JWT_SECRET=

# Cloudinary (used by /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP account used by /api/sendmail
SMTP_USER=
SMTP_PASS=

# Google Analytics 4 Data API (dashboard reports)
# Numeric GA4 property id (GA Admin -> Property settings), digits only
GA_PROPERTY_ID=
# Service account with Viewer access on the GA4 property
GA_CLIENT_EMAIL=
# Keep the quoted \n form, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GA_PRIVATE_KEY=
